#!/usr/bin/env bash
# Simple CLI wrapper for cfm_ledger_autotemplate.py
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# If no subcommand is provided, or the first arg is an option (starts with -),
# default to the "batch" subcommand so you can run:
#   ./cfm-ledger --csv myfile.csv --auto-price
if [[ $# -eq 0 ]]; then
  set -- batch
elif [[ "$1" == -* ]]; then
  set -- batch "$@"
fi

python3 "${SCRIPT_DIR}/cfm_journal/cfm_ledger_autotemplate.py" "$@"
